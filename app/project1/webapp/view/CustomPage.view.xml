<mvc:View
    controllerName="project1.controller.CustomPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:macros="sap.fe.macros"
>
    <f:DynamicPage>
        <!-- Header -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Employee Dashboard" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Content = Cards -->
        <f:content>
            <VBox>
                <!-- Card 1: Event List -->
                <macros:Table
                    id="EmployeeTable"
                    metaPath="@com.sap.vocabularies.UI.v1.LineItem"
                />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
